# MEJR Timesheet: configuración de Apache 2.4 para MAMP local y para el hosting.
# Requiere mod_rewrite (activo por defecto en MAMP y en hosting compartido).

# La raíz abre el login real, no el prototipo index.html.
DirectoryIndex login.php

# Detrás de un proxy o CDN que termina TLS, PHP debe ver la conexión como
# HTTPS para emitir la cookie de sesión con Secure. Sin proxy es inofensivo:
# quien envíe la cabecera solo cambia su propio pedido.
SetEnvIf X-Forwarded-Proto "^https" HTTPS=on

RewriteEngine On

# MAMP (HTTP en el puerto 8888): HTTP -> HTTPS en el puerto 8890, mismo host.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^([^:]+):8888$
RewriteRule ^ https://%1:8890%{REQUEST_URI} [R=302,L]

# Hosting: HTTP -> HTTPS en el puerto estándar. Queda en 302 hasta validarlo
# en producción; después puede pasar a 301.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https [NC]
RewriteCond %{HTTP_HOST} ^([^:]+)
RewriteRule ^ https://%1%{REQUEST_URI} [R=302,L]

# Carpetas que no se sirven: configuración, dependencias, migraciones y git.
# config/ y sql/ además tienen su propio .htaccess.
RewriteRule (^|/)(config|vendor|sql|\.git)(/|$) - [F,L,NC]

# Solo se sirven páginas PHP, estilos, scripts e imágenes. Cualquier otro
# archivo (respaldos .sql.gz, .zip, .md, .json, .lock, .txt, .log, los .html
# de prototipo) y todo lo que empiece con punto (.env, .git, .DS_Store) da 403.
<FilesMatch "(?i)(^\.|\.(?!(php|css|js|webp|png|jpe?g|gif|svg|ico)$)[^.]*$)">
    Require all denied
</FilesMatch>

# Scripts de prototipo y pruebas locales de conexión.
<FilesMatch "(?i)^((app|consultor)\.js|prueba(-conexion)?\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    # HSTS fuera de localhost: en el navegador del desarrollador afectaría
    # a todos los puertos de localhost durante un año.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTP_HOST} !~ /^(localhost|127\.0\.0\.1)(:[0-9]+)?$/"
</IfModule>

# Caché de estáticos. Al cambiar un CSS o JS, sube su ?v= en los <link>/<script>.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
</IfModule>
